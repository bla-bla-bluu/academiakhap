rules_version = '2';

// Deploy from the Firebase Console: Firestore Database -> Rules -> paste this in -> Publish.
// (Or with the CLI: firebase deploy --only firestore:rules, if you have a firebase.json wired up.)

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function getRole() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && getRole() == 'admin';
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // One profile doc per user, id == their auth uid.
    // Only an admin may create one -- this is what actually grants access, so a self-registered
    // user must go through registrationRequests (below) and wait for admin approval rather than
    // ever being able to write their own role directly.
    match /profiles/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isAdmin();
      // Self-updates may never change role, email, membership status, or renewal date --
      // only an admin can change those -- otherwise a member could grant themselves admin,
      // or mark their own lapsed membership active, via a direct SDK call bypassing the
      // app's UI. The latter two use get() with a default since older profiles predate
      // those fields and wouldn't have them set at all.
      allow update: if isAdmin() || (
        isSelf(uid) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.get('membershipStatus', null) == resource.data.get('membershipStatus', null) &&
        request.resource.data.get('renewalDate', null) == resource.data.get('renewalDate', null)
      );
      allow delete: if isAdmin();
    }

    // A self-registered user (via Google or email/password on the website) lands here with
    // status "pending" until an admin reviews and approves them, at which point the admin
    // creates the matching profiles/{uid} document with a role and removes this request.
    match /registrationRequests/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid) &&
        request.resource.data.status == 'pending' &&
        request.resource.data.fullName is string &&
        request.resource.data.email is string;
      allow update, delete: if isAdmin();
    }

    // Global sequence counter for issuing permanent Member IDs (AKYYMMXXXXX). Only the
    // admin-only approval/backfill flows ever touch this -- never exposed to ordinary members.
    match /counters/{counterId} {
      allow read, write: if isAdmin();
    }

    // A trimmed, non-sensitive mirror of certain profiles/{uid} fields (name, role, memberId,
    // district/state, professional and research fields, network status) that the Member
    // Network directory reads from, so browsing members never requires opening up the private
    // profiles collection itself. Email, phone, age, gotra and exact village never appear
    // here. The owner keeps their own mirror in sync; an admin may also fix or remove one.
    match /publicProfiles/{uid} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isSelf(uid);
    }

    function targetNetworkStatus(uid) {
      return get(/databases/$(database)/documents/profiles/$(uid)).data.get('networkStatus', 'by_request');
    }

    // uid1 has blocked uid2, checked by the fixed id "<blocker>_<blocked>" rather than a
    // query, so it can be tested with a single exists() in the connectionRequests create rule.
    function isBlockedBy(blockerUid, blockedUid) {
      return exists(/databases/$(database)/documents/blocks/$(blockerUid + '_' + blockedUid));
    }

    // A connection request between two members. Only the two parties (or an admin) can ever
    // read one -- this is also where each side's email gets shared once accepted (toEmail is
    // added only on accept), so a request document is the one place contact information moves
    // between two members outside admin's own view. Creating one is blocked if the target has
    // set themselves to "closed" or has blocked the sender; a request may not be answered
    // twice, and only the recipient may accept or decline it. Either party may delete an
    // accepted connection to remove it; the sender alone may withdraw their own still-pending
    // request.
    match /connectionRequests/{id} {
      allow read: if isAdmin() || (isSignedIn() &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid));
      allow create: if isSignedIn() &&
        request.resource.data.fromUid == request.auth.uid &&
        request.resource.data.toUid is string &&
        request.resource.data.toUid != request.auth.uid &&
        request.resource.data.status == 'pending' &&
        targetNetworkStatus(request.resource.data.toUid) != 'closed' &&
        !isBlockedBy(request.resource.data.toUid, request.auth.uid);
      allow update: if isAdmin() || (
        isSignedIn() && resource.data.toUid == request.auth.uid &&
        resource.data.status == 'pending' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt', 'toEmail']) &&
        (request.resource.data.status == 'accepted' || request.resource.data.status == 'declined')
      );
      allow delete: if isAdmin() ||
        (isSignedIn() && resource.data.fromUid == request.auth.uid && resource.data.status == 'pending') ||
        (isSignedIn() && resource.data.status == 'accepted' &&
          (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid));
    }

    // uid on its own blocks a member: prevents that person from ever sending a new connection
    // request (checked above) and lets the blocker filter them out of their own directory view.
    // Only the blocker can see or remove their own block list; the blocked person is never told.
    match /blocks/{id} {
      allow read, delete: if isAdmin() || (isSignedIn() && resource.data.blockerUid == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.blockerUid == request.auth.uid &&
        request.resource.data.blockedUid is string &&
        request.resource.data.blockedUid != request.auth.uid &&
        id == request.resource.data.blockerUid + '_' + request.resource.data.blockedUid;
    }

    // A member reporting another member for admin attention. Only the reporter and an admin
    // ever need to touch this -- read/review/close is admin-only, matching how donations and
    // org expenses are handled elsewhere in this file.
    match /memberReports/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if isSignedIn() &&
        request.resource.data.reporterUid == request.auth.uid &&
        request.resource.data.reportedUid is string &&
        request.resource.data.reason is string &&
        request.resource.data.reason.size() > 0 &&
        request.resource.data.status == 'open';
    }

    // Village Heritage Research Network submissions. A published entry is public -- readable
    // by anyone, signed in or not, since this is meant to be an open educational archive like
    // the main Research section -- while a submitted-but-not-yet-reviewed entry is visible only
    // to its own researcher and admins. Only an admin can move publicationStatus/verification
    // Status (the editorial gate from spec section 19); the researcher may keep editing their
    // own entry's content up until it's published, and may withdraw it while it isn't.
    match /heritageSubmissions/{id} {
      allow read: if resource.data.publicationStatus == 'published' || isAdmin() ||
        (isSignedIn() && resource.data.researcherUid == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.researcherUid == request.auth.uid &&
        request.resource.data.publicationStatus == 'submitted' &&
        request.resource.data.village is string && request.resource.data.village.size() > 0 &&
        request.resource.data.district is string && request.resource.data.district.size() > 0 &&
        request.resource.data.subject is string && request.resource.data.subject.size() > 0 &&
        request.resource.data.historicalClaim is string && request.resource.data.historicalClaim.size() > 0 &&
        request.resource.data.source is string && request.resource.data.source.size() > 0;
      allow update: if isAdmin() || (
        isSignedIn() && resource.data.researcherUid == request.auth.uid &&
        resource.data.publicationStatus != 'published' &&
        request.resource.data.researcherUid == resource.data.researcherUid &&
        request.resource.data.publicationStatus == resource.data.publicationStatus &&
        request.resource.data.get('verificationStatus', null) == resource.data.get('verificationStatus', null)
      );
      allow delete: if isAdmin() ||
        (isSignedIn() && resource.data.researcherUid == request.auth.uid && resource.data.publicationStatus != 'published');
    }

    // Incoming donations -- admin-only in both directions, members never see donor detail.
    match /donations/{id} {
      allow read, write: if isAdmin();
    }

    // Direct org-level expenses -- admin-only in both directions.
    match /orgExpenses/{id} {
      allow read, write: if isAdmin();
    }

    // Admin allots a fund/scholarship to a member; that member can read only their own rows.
    match /memberAllocations/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.memberId == request.auth.uid);
      allow write: if isAdmin();
    }

    // A member logs their own spending; admin can read everything for oversight.
    match /memberExpenses/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.memberId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.memberId == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.memberId == request.auth.uid);
    }

    function isValidPostBody() {
      return request.resource.data.body is string &&
        request.resource.data.body.size() > 0 &&
        request.resource.data.body.size() <= 500;
    }

    // authorRole is denormalized onto every post/comment so the UI can show a role badge
    // without an extra read -- must match the poster's real profile role or it'd let anyone
    // forge an "admin" badge on their own post.
    function isValidAuthorRole() {
      return request.resource.data.authorRole == getRole();
    }

    // Community feed (Vidvat Panchayat) -- any signed-in profile can read every post and post
    // as themselves. Text only, capped at 500 characters; no edit once posted. A non-admin may
    // only ever nudge commentCount up by exactly 1 (when they add a comment); an admin can
    // delete any post to moderate the discussion.
    match /communityPosts/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.commentCount == 0 &&
        isValidPostBody() && isValidAuthorRole();
      allow update: if isAdmin() || (
        isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount']) &&
        request.resource.data.commentCount == resource.data.commentCount + 1
      );
      allow delete: if isAdmin();
    }

    // Comments on a community post -- same rules as posts, scoped by postId. An admin can
    // delete any comment to moderate the discussion.
    match /communityComments/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.authorId == request.auth.uid &&
        isValidPostBody() && isValidAuthorRole();
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Single document holding org-wide totals (donations - org expenses - allotments).
    // Kept in sync by the admin client via batched increment() writes alongside each ledger
    // entry -- there's no Cloud Function maintaining it, so only admin may write it. Every
    // signed-in role may read the totals except scholar, who only sees their own allotment.
    match /orgSummary/{docId} {
      allow read: if isSignedIn() && getRole() != 'scholar';
      allow write: if isAdmin();
    }

    // One per-member summary doc (allotted / spent / remaining), id == member's uid.
    // Admin can write anything on it (e.g. when allotting funds); a member may only nudge
    // their own totalSpent/remainingBalance when logging an expense, never totalAllotted.
    match /memberSummaries/{memberId} {
      allow read: if isAdmin() || isSelf(memberId);
      allow create: if isAdmin();
      allow update: if isAdmin() ||
        (isSelf(memberId) && request.resource.data.totalAllotted == resource.data.totalAllotted);
      allow delete: if isAdmin();
    }
  }
}
